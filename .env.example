# clair-ai 환경변수
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.

# ── 필수 ──────────────────────────────────────────────────────────────────────

# Google AI Studio에서 발급 (https://aistudio.google.com/apikey)
# 없으면 OCR 보정·추출·리스크·요약·임베딩이 전부 조용히 폴백되어
# 분석은 "성공"하지만 결과가 빈다.
GEMINI_API_KEY=

# ── 예산 가드 ─────────────────────────────────────────────────────────────────

# 월 지출 상한(원). 초과하면 /analyze, /qa, /compliance가 429로 거절한다.
# 실측 기준 분석 1건 ≈ 41원이므로 5000원이면 월 약 123건.
MONTHLY_BUDGET_KRW=5000

# 원화 환산 환율. 토큰 사용량을 원화로 계산할 때 쓴다.
USD_TO_KRW=1400

# ── 배포 ──────────────────────────────────────────────────────────────────────

# ChromaDB(.law_db, .contract_db)와 예산 카운터(.usage_db)가 저장되는 디렉터리.
# 컨테이너 배포 시 반드시 영속 볼륨 경로를 지정할 것.
# 이 경로가 휘발성이면 재시작마다 RAG 인덱스가 날아가고
# 월 예산 카운터가 0으로 초기화되어 지출 상한이 무력화된다.
CLAIR_AI_DATA_DIR=/data

# ── 선택 ──────────────────────────────────────────────────────────────────────

# law.go.kr OpenAPI OC 키. 없으면 하드코딩된 정적 법령(~23개 조문)으로 폴백한다.
LAW_API_KEY=
